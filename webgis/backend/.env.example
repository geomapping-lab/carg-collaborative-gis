# Copy to .env and fill in. Never commit the real .env file.

# PostgreSQL connection used by the backend (service account, read-only on survey data)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=progetto_rilevamento
DB_USER=webgis_user
DB_PASSWORD=change-me

# WebGIS login form accounts: comma-separated user:password pairs.
# Independent from PostgreSQL roles; use the surveyors' role names so that
# the per-surveyor filter matches created_by.
WEBGIS_USERS=ril_user1:change-me,ril_user2:change-me,dir_rilevamento:change-me

# Optional: allowed origins for development (Vite dev server), comma-separated.
# Leave empty in production: the frontend is served by FastAPI itself.
CORS_ORIGINS=

# Optional: path of the built frontend (default: ../frontend/dist)
# FRONTEND_DIST=
